[Unit]
Description=MuxCore Module - health-monitor
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=muxcore
Group=muxcore
ExecStart=/usr/local/bin/health-monitor --muxcore-mesh-addr localhost:9090 --muxcore-module-id health-monitor
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
CapabilityBoundingSet=
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
[Install]
WantedBy=multi-user.target
