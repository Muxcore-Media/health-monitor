# MuxCore Health Monitor — Environment Variables
# Copy to .env and adjust for your environment.

# Core connection
# MUXCORE_GRPC_ADDR=localhost:9090
# MUXCORE_INSECURE_DISABLE_TLS=true

# Module identity
# MUXCORE_MODULE_ID=health-monitor

# Module-specific settings
# HEALTH_MONITOR_GRPC_ADDR=127.0.0.1:9202
# HEALTH_MONITOR_HTTP_ADDR=127.0.0.1:9203
# HEALTH_MONITOR_INTERVAL=30s
